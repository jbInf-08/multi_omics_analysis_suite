# =============================================================================
# Multi-Omics Analysis Suite - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME="Multi-Omics Analysis Suite"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/multi_omics
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Neo4j (for graph data)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# =============================================================================
# Celery Configuration
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =============================================================================
# Authentication
# =============================================================================
# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Bioinformatics tools (/api/v1/tools): JWT, optional X-API-Key, or TOOLS_ALLOW_ANONYMOUS
TOOLS_API_KEY=
TOOLS_ALLOW_ANONYMOUS=false
TOOLS_CHEMISTRY_RATE_LIMIT=30
TOOLS_CHEMISTRY_RATE_PERIOD_SECONDS=60
# auto | redis | memory — auto uses Redis for shared limits across API replicas when REDIS_URL is up
TOOLS_CHEMISTRY_RATE_LIMIT_BACKEND=auto
PIPELINE_ARTIFACTS_DIR=./data/pipeline_artifacts
PIPELINE_ARTIFACT_MAX_EMBED_BYTES=95000

# OAuth2 Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# =============================================================================
# Storage Configuration
# =============================================================================
# Local storage
DATA_DIR=/data/multi_omics
UPLOAD_DIR=/data/uploads
RESULTS_DIR=/data/results

# S3-compatible storage (optional)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=multi-omics-data
S3_REGION=us-east-1

# =============================================================================
# AI/ML Configuration
# =============================================================================
# OpenAI (for AI chatbot)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Anthropic
ANTHROPIC_API_KEY=

# HuggingFace
HUGGINGFACE_API_KEY=

# =============================================================================
# External Services
# =============================================================================
# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@multi-omics.io

# Slack notifications (optional)
SLACK_WEBHOOK_URL=

# =============================================================================
# Monitoring & Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# Sentry (error tracking)
SENTRY_DSN=

# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# External Databases/APIs
# =============================================================================
# NCBI/Entrez
NCBI_API_KEY=
NCBI_EMAIL=your-email@example.com

# Ensembl
ENSEMBL_REST_SERVER=https://rest.ensembl.org

# UniProt
UNIPROT_REST_SERVER=https://rest.uniprot.org

# =============================================================================
# Cancer Data Sources (API Keys)
# =============================================================================
# COSMIC - https://cancer.sanger.ac.uk/cosmic/register
COSMIC_API_KEY=
COSMIC_EMAIL=

# OncoKB - https://www.oncokb.org/apiAccess
ONCOKB_API_TOKEN=

# DrugBank - https://go.drugbank.com/public_users/sign_up
DRUGBANK_API_KEY=

# DepMap/CCLE - https://depmap.org/portal/
DEPMAP_API_KEY=

# cBioPortal - https://www.cbioportal.org/
CBIOPORTAL_API_KEY=

# CIViC - https://civicdb.org/
CIVIC_API_KEY=

# PharmGKB - https://www.pharmgkb.org/
PHARMGKB_API_KEY=

# STRING - https://string-db.org/
STRING_API_KEY=

# TCIA (Imaging) - https://www.cancerimagingarchive.net/
TCIA_API_KEY=

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_GRAPHQL=true
ENABLE_WEBSOCKET=true
ENABLE_KAFKA=false
ENABLE_MULTITENANCY=false

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
